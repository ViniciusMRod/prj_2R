# =============================================================================
# PCMSO Alert System — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais
# =============================================================================

# Database
DATABASE_URL=postgresql://pcmso_user:pcmso_password@localhost:5432/pcmso_alerts
DB_ECHO=False

# Gmail API
GMAIL_CREDENTIALS_FILE=config/gmail_credentials.json
GMAIL_TOKEN_FILE=config/gmail_token.json
GMAIL_SENDER_EMAIL=alertas@seudominio.com.br

# WhatsApp — Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE=pcmso_instance

# n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/
N8N_API_KEY=your_n8n_api_key

# App
SECRET_KEY=troque_por_uma_chave_secreta_forte_aqui
ENVIRONMENT=development
LOG_LEVEL=INFO

# Paths
PCMSO_RAW_PATH=data/pcmso_raw/
PCMSO_PENDING_PATH=data/pcmso_pending_validation/
PCMSO_PROCESSED_PATH=data/pcmso_processed/

# FastAPI
API_HOST=0.0.0.0
API_PORT=5000

# Streamlit
DASHBOARD_PORT=8501
